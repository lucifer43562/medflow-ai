# MedFlow AI Environment Configuration
# API Keys (Optional - System automatically uses deterministic clinical safety fallback if key is omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Clinical Safety Thresholds
CONFIDENCE_THRESHOLD=0.80
CRITICAL_SEVERITY_THRESHOLD=85
MAX_ORTOOLS_SOLVER_TIME_SECONDS=2.0
ENABLE_DETERMINISTIC_NEWS2_OVERRIDE=true
